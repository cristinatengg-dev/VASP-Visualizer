FROM node:22.22-bullseye AS web
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22.22-bullseye AS runtime
WORKDIR /app/server
COPY server/package*.json ./
RUN npm ci --omit=dev
WORKDIR /app
COPY server/src ./server/src
COPY server/platform.cjs ./server/platform.cjs
COPY --from=web /app/dist ./dist
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
EXPOSE 3000
CMD ["node", "server/platform.cjs"]
