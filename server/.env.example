# Runtime / backend deployment example
# Copy to server/.env when you run the backend with:
#   cd server && npm start

# Production must use a replica set so Session/Artifact/Event writes remain atomic.
# docker-compose.yml provisions a single-node rs0 automatically.
RUNTIME_MONGODB_URI=mongodb://127.0.0.1:27017/vasp_visualizer?replicaSet=rs0
# Local development only: set to 1 when using a standalone MongoDB without transactions.
RUNTIME_DISABLE_TRANSACTIONS=0

# Phone verification delivery (Tencent Cloud SMS)
# The approved template must use {1} for the six-digit code and {2} for validity minutes.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# Authentication, privileged maintenance API secret, and optional comma-separated
# enterprise admin phone numbers (E.164). Use independent random values of at
# least 32 bytes for TOKEN_SECRET and ADMIN_SECRET.
TOKEN_SECRET=
ADMIN_SECRET=
ADMIN_PHONES=+8613800000000

# Runtime demo / workers
ENABLE_AGENT_RUNTIME_DEMO=1
ENABLE_AGENT_RUNTIME_WORKERS=1

# Text agents: Idea / Modeling / Compute / Rendering text parsing
TEXT_LLM_API_KEY=
TEXT_LLM_BASE_URL=https://mangdream.com/api/innoreation/v1/proxy
TEXT_LLM_MODEL=deepseek-v4-pro
TEXT_LLM_AUTH_HEADER=X-Proxy-Key
# Optional: use Authorization providers with TEXT_LLM_AUTH_HEADER=Authorization and TEXT_LLM_AUTH_SCHEME=Bearer
# Optional: bind requests to a VPN/local source address, e.g. TEXT_LLM_LOCAL_ADDRESS=10.10.82.2

# Rendering image / vision models
IMAGE_LLM_API_KEY=
IMAGE_LLM_BASE_URL=https://api.aipaibox.com/v1
IMAGE_LLM_MODEL=gpt-image-2
IMAGE_LLM_AUTH_HEADER=Authorization
IMAGE_LLM_AUTH_SCHEME=Bearer
IMAGE_LLM_STRATEGY=images_first
IMAGE_LLM_USE_PROXY=0
# Optional: IMAGE_LLM_QUALITY=low|medium|high|auto, IMAGE_LLM_OUTPUT_FORMAT=png|jpeg|webp
GEMINI_API_KEY=
GEMINI_BASE_URL=https://api.aipaibox.com/v1
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Modeling
MODELING_PYTHON_EXECUTABLE=/absolute/path/to/server/.venv-modeling/bin/python
STRUCTURE_LIBRARY_DIR=/absolute/path/to/server/data/structure-libraries
STRUCTURE_LIBRARY_INDEX=/absolute/path/to/server/data/structure-libraries/index.sqlite
PUBCHEM3D_RECORD_DIR=
PUBCHEM3D_SDF_DIR=
COD_CIF_DIR=
JARVIS_JSON_DIR=
MP_API_KEY=
MP_PROXY_URL=https://mp-proxy.cristinatengg.workers.dev  # Cloudflare Worker proxy for MP API (auto-fallback on 403)
ATOMLY_OPTIMADE_BASE_URL=
ATOMLY_CIF_DIR=
CSD_CIF_DIR=
CSD_PYTHON_API=0
ICSD_OPTIMADE_BASE_URL=
ICSD_CIF_DIR=

# Compute: run directly on the same server that hosts this backend
COMPUTE_LOCAL_COMMAND="mpirun -np 8 vasp_std"
COMPUTE_LOCAL_SHELL=/bin/zsh
COMPUTE_LOCAL_RUNNER_ID=server-local

# Pseudopotentials
VASP_PSP_DIR=/absolute/path/to/potpaw_PBE
# Alternative names also supported by the runtime:
# VASP_POTCAR_DIR=/absolute/path/to/potpaw_PBE
# POTCAR_LIBRARY_DIR=/absolute/path/to/potpaw_PBE

# Runtime storage must point to persistent disk. docker-compose.yml mounts a named volume here.
RUNTIME_ARTIFACT_STORAGE_DIR=/absolute/path/to/runtime-storage/artifacts
RUNTIME_JOB_STORAGE_DIR=/absolute/path/to/runtime-storage/jobs

# Worker tuning
RUNTIME_APPROVAL_SWEEPER_INTERVAL_MS=60000
RUNTIME_JOB_MONITOR_INTERVAL_MS=15000
RUNTIME_HARVEST_LAG_MONITOR_INTERVAL_MS=120000

# Optional Slurm profile
HPC_SLURM_PARTITION=
HPC_EXECUTABLE=
HPC_SCHEDULER_REF=slurm-default
HPC_NODES=1
HPC_TASKS_PER_NODE=32
HPC_WALLTIME=12:00:00
HPC_MODULE_LOAD=

# Optional PBS profile
HPC_PBS_QUEUE=

# Optional: queue PBS jobs for an external local compute agent
COMPUTE_AGENT_TOKEN=
COMPUTE_AGENT_SCHEDULER_REF=pbs-agent
COMPUTE_AGENT_BASE_URL=
COMPUTE_AGENT_EXECUTION_PROFILE=pbs_default
COMPUTE_AGENT_POLL_INTERVAL_MS=15000

# Optional: submit/query Slurm over SSH instead of requiring local sbatch/squeue
HPC_SSH_HOST=
HPC_SSH_PORT=22
HPC_SSH_USER=
HPC_SSH_KEY_PATH=
HPC_REMOTE_BASE_DIR=
HPC_REMOTE_POTCAR_DIR=
HPC_REMOTE_SHELL=/bin/bash
HPC_REMOTE_PRELUDE=

# Alipay Payment (当面付)
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/api/payment/alipay-notify
