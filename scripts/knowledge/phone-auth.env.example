# Copy to .dev/phone-auth.env only when configuring this isolated development server.
# local: shows a development code in the login page; sends no SMS.
# tencent: uses the previously verified Tencent SMS adapter; never returns a code to the browser.
ELIANGMAT_SMS_MODE=local
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
