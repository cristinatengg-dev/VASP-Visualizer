# Copy to .dev/model.env (mode 600). This file is ignored by Git and read only by the backend.
# Use a dedicated mainland Tencent TokenHub API key. Never reuse Gemini credentials.
# An empty key disables external inference; development never falls back to production.
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
HUNYUAN_API_KEY=
HUNYUAN_TEXT_MODEL=hy3
HUNYUAN_MAX_OUTPUT_TOKENS=8192
