# Copy to .config/platform.env; never commit the filled file.
# Separate HTTPS ingress must preserve the Host header and disable SSE buffering.
ELIANGMAT_ORIGINS=https://your-domain.example
HOST=127.0.0.1
PORT=3000
ELIANGMAT_STORAGE_DIR=.data/platform

TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# Mainland Tencent TokenHub only. Obtain a dedicated TokenHub API key;
# Tencent SMS SecretId/SecretKey and old Gemini credentials are NOT model keys.
# Leave the key empty to keep local retrieval only (no external inference).
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
HUNYUAN_API_KEY=
HUNYUAN_TEXT_MODEL=hy3
# Per-call ceiling (2048–16384); detailed plans use this ceiling, short replies at most 4096.
HUNYUAN_MAX_OUTPUT_TOKENS=8192
OPENALEX_API_KEY=
CROSSREF_EMAIL=
UNPAYWALL_EMAIL=
